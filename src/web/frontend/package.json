    "@angular/router": "^22.2.3",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/heroicons": "^36.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
